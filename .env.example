# Copie para .env e ajuste. Valores abaixo servem só para o ambiente local (docker compose).
# Em homologação e produção, as variáveis ficam no CapRover (ENT-01, seção 3). Nunca versione o .env.

NODE_ENV=development
PORT=3000

# Banco de dados (PostgreSQL 16)
DATABASE_URL=postgresql://jaguara:jaguara@localhost:5432/jaguara
DATABASE_URL_TESTE=postgresql://jaguara:jaguara@localhost:5432/jaguara_teste

# Filas, revogação de sessões e eventos (Redis 7)
REDIS_URL=redis://localhost:6379

# Autenticação (ADR-009, ADR-012). Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
JWT_EXPIRACAO_MINUTOS=15
SESSAO_INATIVIDADE_HORAS=4

# Cifragem de colunas de nível Restrito (CPF, credenciais de integração), AES-256-GCM (ARQ-02).
# 32 bytes em base64. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAVE_CRIPTOGRAFIA=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

# Armazenamento de arquivos compatível com S3
S3_ENDPOINT=http://localhost:8333
S3_REGIAO=us-east-1
S3_BUCKET=jaguara-arquivos
S3_ACCESS_KEY=jaguara
S3_SECRET_KEY=jaguara-local

# E-mail transacional. Local: SMTP do Mailpit (http://localhost:8025). Produção: API do provedor.
EMAIL_PROVEDOR=smtp
EMAIL_REMETENTE=Jaguara <nao-responda@jaguarapet.com.br>
SMTP_HOST=localhost
SMTP_PORTA=1025
EMAIL_API_KEY=

# Origens liberadas no CORS e links enviados por e-mail
URL_WEB=http://localhost:5173
URL_APP=jaguara://

# Assistente virtual (ARQ-03, seção 3.5). Sem chave, as respostas são simuladas.
ANTHROPIC_API_KEY=
# ID do modelo no provedor de IA (ENT-01).
IA_MODELO=
IA_LIMITE_DIARIO=30

# Gateway de pagamento Mercado Pago (ARQ-03, seção 3.1). Use as credenciais de teste.
# Sem token, o gateway é simulado. O segredo valida a assinatura dos webhooks (RN36).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SEGREDO=
# Endereço público da API para o gateway chamar o webhook (ex.: https://api.jaguarapet.com.br).
URL_API_PUBLICA=
