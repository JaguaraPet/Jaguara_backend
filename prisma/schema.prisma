generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  previewFeatures     = ["partialIndexes"]
  moduleFormat        = "cjs"
  // Imports sem extensão: compatível com o build CommonJS do Nest, o Jest e o ts-node.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model Administrador {
  id                 String               @id @db.Uuid
  nome               String               @db.VarChar(255)
  criadoEm           DateTime             @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm       DateTime             @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  usuario            Usuario              @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_administrador_heranca")
  chamadoSuporte     ChamadoSuporte[]
  integracao         Integracao[]
  intervencaoSuporte IntervencaoSuporte[]
  webhook            Webhook[]

  @@map("administrador")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.

model Agendamento {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dataHoraInicio  DateTime               @map("data_hora_inicio") @db.Timestamptz(6)
  dataHoraFim     DateTime               @map("data_hora_fim") @db.Timestamptz(6)
  precoContratado Decimal                @map("preco_contratado") @db.Decimal(12, 2)
  status          StatusAgendamento
  criadoEm        DateTime               @map("criado_em") @db.Timestamptz(6)
  solicitacaoId   String?                @unique @map("solicitacao_id") @db.Uuid
  servicoId       String                 @map("servico_id") @db.Uuid
  petId           String                 @map("pet_id") @db.Uuid
  profissionalId  String?                @map("profissional_id") @db.Uuid
  recursoId       String?                @map("recurso_id") @db.Uuid
  eventoId        String?                @map("evento_id") @db.Uuid
  atualizadoEm    DateTime               @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  evento          EventoCalendario?      @relation(fields: [eventoId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_agendamento_evento_id")
  pet             Pet                    @relation(fields: [petId], references: [id], onUpdate: NoAction, map: "fk_agendamento_pet_id")
  profissional    FuncionarioEnterprise? @relation(fields: [profissionalId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_agendamento_profissional_id")
  recurso         Recurso?               @relation(fields: [recursoId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_agendamento_recurso_id")
  servico         Servico                @relation(fields: [servicoId], references: [id], onUpdate: NoAction, map: "fk_agendamento_servico_id")
  solicitacao     SolicitacaoServico?    @relation(fields: [solicitacaoId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_agendamento_solicitacao_id")
  atendimento     Atendimento?
  pagamento       Pagamento[]

  @@index([dataHoraInicio], map: "ix_agendamento_inicio")
  @@map("agendamento")
}

model AlergiaRestricao {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo              TipoAlergiaRestricao
  descricao         String
  gravidade         Gravidade
  dataIdentificacao DateTime?            @map("data_identificacao") @db.Date
  observacoes       String?
  petId             String               @map("pet_id") @db.Uuid
  criadoEm          DateTime             @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm      DateTime             @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  pet               Pet                  @relation(fields: [petId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_alergia_restricao_pet_id")

  @@map("alergia_restricao")
}

model Assinatura {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plano        TipoPlano
  dataInicio   DateTime         @map("data_inicio") @db.Date
  dataFim      DateTime?        @map("data_fim") @db.Date
  status       StatusAssinatura
  tutorId      String           @map("tutor_id") @db.Uuid
  criadoEm     DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime         @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  tutor        Tutor            @relation(fields: [tutorId], references: [id], onUpdate: NoAction, map: "fk_assinatura_tutor_id")
  pagamento    Pagamento[]

  @@map("assinatura")
}

model Atendimento {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dataHoraInicio          DateTime               @map("data_hora_inicio") @db.Timestamptz(6)
  dataHoraFim             DateTime?              @map("data_hora_fim") @db.Timestamptz(6)
  procedimentosRealizados String                 @map("procedimentos_realizados")
  observacoesClinicas     String?                @map("observacoes_clinicas")
  status                  StatusAtendimento
  finalizadoEm            DateTime?              @map("finalizado_em") @db.Timestamptz(6)
  agendamentoId           String?                @unique @map("agendamento_id") @db.Uuid
  petId                   String                 @map("pet_id") @db.Uuid
  registradoPorId         String                 @map("registrado_por_id") @db.Uuid
  profissionalId          String?                @map("profissional_id") @db.Uuid
  criadoEm                DateTime               @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm            DateTime               @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  agendamento             Agendamento?           @relation(fields: [agendamentoId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_atendimento_agendamento_id")
  pet                     Pet                    @relation(fields: [petId], references: [id], onUpdate: NoAction, map: "fk_atendimento_pet_id")
  profissional            FuncionarioEnterprise? @relation(fields: [profissionalId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_atendimento_profissional_id")
  registradoPor           Usuario                @relation(fields: [registradoPorId], references: [id], onUpdate: NoAction, map: "fk_atendimento_registrado_por_id")
  itemAtendimento         ItemAtendimento[]

  @@map("atendimento")
}

model CalendarioExterno {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provedor            ProvedorCalendario
  contaExterna        String             @map("conta_externa") @db.VarChar(255)
  tokenAutorizacao    String             @map("token_autorizacao") @db.VarChar(255)
  autorizado          Boolean
  ultimaSincronizacao DateTime?          @map("ultima_sincronizacao") @db.Timestamptz(6)
  usuarioId           String             @map("usuario_id") @db.Uuid
  criadoEm            DateTime           @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm        DateTime           @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  usuario             Usuario            @relation(fields: [usuarioId], references: [id], onUpdate: NoAction, map: "fk_calendario_externo_usuario_id")
  eventoCalendario    EventoCalendario[]

  @@map("calendario_externo")
}

model CategoriaDespesa {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome         String    @unique @db.VarChar(255)
  descricao    String?
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  despesa      Despesa[]

  @@map("categoria_despesa")
}

model ChamadoSuporte {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  protocolo          String               @unique @db.VarChar(255)
  titulo             String               @db.VarChar(255)
  descricao          String
  status             StatusChamado
  dataAbertura       DateTime             @map("data_abertura") @db.Timestamptz(6)
  dataFechamento     DateTime?            @map("data_fechamento") @db.Timestamptz(6)
  solicitanteId      String               @map("solicitante_id") @db.Uuid
  atendenteId        String?              @map("atendente_id") @db.Uuid
  criadoEm           DateTime             @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm       DateTime             @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  atendente          Administrador?       @relation(fields: [atendenteId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_chamado_suporte_atendente_id")
  solicitante        Usuario              @relation(fields: [solicitanteId], references: [id], onUpdate: NoAction, map: "fk_chamado_suporte_solicitante_id")
  intervencaoSuporte IntervencaoSuporte[]

  @@map("chamado_suporte")
}

model Cliente {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo        String            @db.VarChar(255)
  nome          String            @db.VarChar(255)
  cpfCifrado    Bytes?            @map("cpf_cifrado")
  cpfHash       String?           @map("cpf_hash") @db.Char(64)
  telefone      String?           @db.VarChar(20)
  email         String?           @db.VarChar(255)
  dataVinculo   DateTime          @map("data_vinculo") @db.Date
  observacoes   String?
  ativo         Boolean
  empresaId     String            @map("empresa_id") @db.Uuid
  tutorId       String?           @map("tutor_id") @db.Uuid
  criadoEm      DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime          @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  empresa       EmpresaEnterprise @relation(fields: [empresaId], references: [id], onUpdate: NoAction, map: "fk_cliente_empresa_id")
  tutor         Tutor?            @relation(fields: [tutorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_cliente_tutor_id")
  clientePet    ClientePet[]
  consentimento Consentimento[]

  @@unique([empresaId, tutorId], map: "uq_cliente")
  @@unique([empresaId, cpfHash], map: "uq_cliente_cpf")
  @@map("cliente")
}

model ClientePet {
  clienteId String  @map("cliente_id") @db.Uuid
  petId     String  @map("pet_id") @db.Uuid
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cliente_pet_cliente_id")
  pet       Pet     @relation(fields: [petId], references: [id], onUpdate: NoAction, map: "fk_cliente_pet_pet_id")

  @@id([clienteId, petId])
  @@map("cliente_pet")
}

model CompartilhamentoPet {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  destinatarioEmail String?                @map("destinatario_email") @db.VarChar(255)
  escopos           EscopoAcesso[]
  token             String                 @unique @db.VarChar(255)
  dataConcessao     DateTime               @map("data_concessao") @db.Timestamptz(6)
  dataExpiracao     DateTime?              @map("data_expiracao") @db.Timestamptz(6)
  status            StatusCompartilhamento
  petId             String                 @map("pet_id") @db.Uuid
  empresaId         String?                @map("empresa_id") @db.Uuid
  criadoEm          DateTime               @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm      DateTime               @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  empresa           EmpresaEnterprise?     @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_compartilhamento_pet_empresa_id")
  pet               Pet                    @relation(fields: [petId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_compartilhamento_pet_pet_id")

  @@map("compartilhamento_pet")
}

model ConfiguracaoNotificacao {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipoEvento          TipoEvento       @map("tipo_evento")
  canal               CanalNotificacao
  antecedenciaMinutos Int              @map("antecedencia_minutos")
  ativa               Boolean
  usuarioId           String           @map("usuario_id") @db.Uuid
  criadoEm            DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm        DateTime         @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  usuario             Usuario          @relation(fields: [usuarioId], references: [id], onUpdate: NoAction, map: "fk_configuracao_notificacao_usuario_id")

  @@map("configuracao_notificacao")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.

model Consentimento {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aceito          Boolean
  dataAceite      DateTime               @map("data_aceite") @db.Timestamptz(6)
  dataRevogacao   DateTime?              @map("data_revogacao") @db.Timestamptz(6)
  ipOrigem        String?                @map("ip_origem") @db.VarChar(255)
  meioColeta      MeioColeta             @map("meio_coleta")
  evidenciaUrl    String?                @map("evidencia_url") @db.VarChar(2048)
  tokenLink       String?                @unique @map("token_link") @db.VarChar(255)
  usuarioId       String?                @map("usuario_id") @db.Uuid
  clienteId       String?                @map("cliente_id") @db.Uuid
  registradoPorId String?                @map("registrado_por_id") @db.Uuid
  termoId         String                 @map("termo_id") @db.Uuid
  criadoEm        DateTime               @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm    DateTime               @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  cliente         Cliente?               @relation(fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_consentimento_cliente_id")
  registradoPor   FuncionarioEnterprise? @relation(fields: [registradoPorId], references: [id], onUpdate: NoAction, map: "fk_consentimento_registrado_por_id")
  termo           TermoUso               @relation(fields: [termoId], references: [id], onUpdate: NoAction, map: "fk_consentimento_termo_id")
  usuario         Usuario?               @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_consentimento_usuario_id")

  @@map("consentimento")
}

model Conversa {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo         TipoConversa
  dataInicio   DateTime           @map("data_inicio") @db.Timestamptz(6)
  status       StatusConversa
  tutorId      String             @map("tutor_id") @db.Uuid
  empresaId    String?            @map("empresa_id") @db.Uuid
  petId        String?            @map("pet_id") @db.Uuid
  criadoEm     DateTime           @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime           @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  empresa      EmpresaEnterprise? @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_conversa_empresa_id")
  pet          Pet?               @relation(fields: [petId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_conversa_pet_id")
  tutor        Tutor              @relation(fields: [tutorId], references: [id], onUpdate: NoAction, map: "fk_conversa_tutor_id")
  mensagem     Mensagem[]

  @@map("conversa")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.

model Despesa {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  descricao      String
  valor          Decimal          @db.Decimal(12, 2)
  data           DateTime         @db.Date
  comprovanteUrl String?          @map("comprovante_url") @db.VarChar(2048)
  petId          String           @map("pet_id") @db.Uuid
  categoriaId    String           @map("categoria_id") @db.Uuid
  pagamentoId    String?          @map("pagamento_id") @db.Uuid
  criadoEm       DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime         @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  categoria      CategoriaDespesa @relation(fields: [categoriaId], references: [id], onUpdate: NoAction, map: "fk_despesa_categoria_id")
  pagamento      Pagamento?       @relation(fields: [pagamentoId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_despesa_pagamento_id")
  pet            Pet              @relation(fields: [petId], references: [id], onUpdate: NoAction, map: "fk_despesa_pet_id")

  @@map("despesa")
}

model DocumentoPet {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo       String        @db.VarChar(255)
  tipo         TipoDocumento
  arquivoUrl   String        @map("arquivo_url") @db.VarChar(2048)
  dataEmissao  DateTime?     @map("data_emissao") @db.Date
  dataValidade DateTime?     @map("data_validade") @db.Date
  dataUpload   DateTime      @map("data_upload") @db.Timestamptz(6)
  petId        String        @map("pet_id") @db.Uuid
  criadoEm     DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime      @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  pet          Pet           @relation(fields: [petId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_documento_pet_pet_id")

  @@map("documento_pet")
}

model EmpresaEnterprise {
  id                    String                  @id @db.Uuid
  cnpj                  String                  @unique @db.Char(14)
  razaoSocial           String                  @map("razao_social") @db.VarChar(255)
  nomeFantasia          String                  @map("nome_fantasia") @db.VarChar(255)
  tipo                  TipoEmpresa
  enderecoCep           String                  @map("endereco_cep") @db.VarChar(10)
  enderecoLogradouro    String                  @map("endereco_logradouro") @db.VarChar(120)
  enderecoNumero        String                  @map("endereco_numero") @db.VarChar(10)
  enderecoComplemento   String?                 @map("endereco_complemento") @db.VarChar(120)
  enderecoBairro        String                  @map("endereco_bairro") @db.VarChar(120)
  enderecoCidade        String                  @map("endereco_cidade") @db.VarChar(120)
  enderecoUf            String                  @map("endereco_uf") @db.Char(2)
  criadoEm              DateTime                @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm          DateTime                @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  cliente               Cliente[]
  compartilhamentoPet   CompartilhamentoPet[]
  conversa              Conversa[]
  usuario               Usuario                 @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_empresa_enterprise_heranca")
  funcionarioEnterprise FuncionarioEnterprise[]
  pagamento             Pagamento[]
  perfilAcesso          PerfilAcesso[]
  recurso               Recurso[]
  servico               Servico[]

  @@map("empresa_enterprise")
}

model Especie {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome         String   @unique @db.VarChar(255)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  raca         Raca[]

  @@map("especie")
}

model EventoCalendario {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo              String             @db.VarChar(255)
  descricao           String?
  tipo                TipoEvento
  dataHoraInicio      DateTime           @map("data_hora_inicio") @db.Timestamptz(6)
  dataHoraFim         DateTime?          @map("data_hora_fim") @db.Timestamptz(6)
  local               String?            @db.VarChar(255)
  origem              OrigemEvento
  idExterno           String?            @map("id_externo") @db.VarChar(255)
  petId               String             @map("pet_id") @db.Uuid
  criadoPorId         String             @map("criado_por_id") @db.Uuid
  calendarioExternoId String?            @map("calendario_externo_id") @db.Uuid
  criadoEm            DateTime           @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm        DateTime           @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  agendamento         Agendamento[]
  calendarioExterno   CalendarioExterno? @relation(fields: [calendarioExternoId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_evento_calendario_calendario_externo_id")
  criadoPor           Usuario            @relation(fields: [criadoPorId], references: [id], onUpdate: NoAction, map: "fk_evento_calendario_criado_por_id")
  pet                 Pet                @relation(fields: [petId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_evento_calendario_pet_id")

  @@index([petId, dataHoraInicio], map: "ix_evento_pet_inicio")
  @@map("evento_calendario")
}

model Exame {
  id                  String          @id @db.Uuid
  tipoExame           String          @map("tipo_exame") @db.VarChar(255)
  dataRealizacao      DateTime        @map("data_realizacao") @db.Date
  laboratorio         String?         @db.VarChar(255)
  resultado           String?
  arquivoResultadoUrl String?         @map("arquivo_resultado_url") @db.VarChar(2048)
  criadoEm            DateTime        @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm        DateTime        @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  registroClinico     RegistroClinico @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_exame_heranca")

  @@map("exame")
}

model FuncionarioEnterprise {
  id             String            @id @db.Uuid
  nome           String            @db.VarChar(255)
  cpfCifrado     Bytes             @map("cpf_cifrado")
  cpfHash        String            @unique @map("cpf_hash") @db.Char(64)
  cargo          String?           @db.VarChar(255)
  ativo          Boolean
  empresaId      String            @map("empresa_id") @db.Uuid
  criadoEm       DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime          @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  agendamento    Agendamento[]
  atendimento    Atendimento[]
